# Beacon Live — Environment Variables

# Frontend talks to the local realtime backend through Nginx.
VITE_WEATHER_BACKEND_URL=/api

# Local realtime backend
WEATHER_SOURCE_MODE=real
WEATHER_POLL_MS=20000
WEATHER_HEARTBEAT_MS=15000
WEATHER_REQUEST_TIMEOUT_MS=15000
WEATHER_READY_MAX_AGE_MS=300000
WEATHER_MAX_OBSERVATIONS=500
METEOFRANCE_KEY=
WINDSUP_USER=
WINDSUP_PASS=
WUNDERGROUND_API_KEY=

# Web Push. Generate once with: npx web-push generate-vapid-keys
# Keep the private key secret and stable across redeployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ajaccio.surf

# Backend monitoring (server-only)
APP_ENV=production
APP_RELEASE=git-commit-sha
SENTRY_DSN=
MONITOR_HEARTBEAT_URL=
MONITOR_HEARTBEAT_INTERVAL_MS=60000

VITE_INFOCLIMAT_TOKEN=your_token_here
